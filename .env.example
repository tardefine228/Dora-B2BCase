# Copy to .env for local Docker Compose configuration. Do not commit .env.
API_PORT=8000
API_BIND_ADDRESS=0.0.0.0
LOG_LEVEL=INFO
CLASSIFIER_BACKEND=catalog

# Тяжёлый шаг сборки образа: torch (CPU) + sentence-transformers + веса модели
# с Hugging Face + обучение реранкера (~10 минут в первый раз). По умолчанию
# включён; быстрая сборка (~2 мин) без него — рантайм останется на spaCy-векторах:
#   INSTALL_TRANSFORMER=false docker compose up --build
INSTALL_TRANSFORMER=true

# ML/Qdrant is optional and requires a local model directory before going offline.
# To enable the semantic backend: INSTALL_ML=true, CLASSIFIER_BACKEND=qdrant,
# then download the transformer (see scripts/download_model.py) and set a strong
# ADMIN_API_KEY. Compose also sets the runtime ML_ENABLED flag from INSTALL_ML.
INSTALL_ML=false
# Do NOT set MODEL_NAME in .env for the docker compose stack: the image bakes the
# transformer into /opt/models/embedder and compose already defaults MODEL_NAME to
# that path. A stale host path here (e.g. ./models/bge-m3 from older revisions)
# silently downgrades the runtime to spaCy vectors - /health/ready then reports
# "spacy-ru_core_news_md" even though the build downloaded e5 successfully.
# Uncomment only to point the stack at a custom model directory:
#MODEL_NAME=/opt/models/embedder
MODEL_DEVICE=cpu
MODEL_LOCAL_ONLY=true
MODEL_BATCH_SIZE=16
MAX_CONCURRENT_INFERENCES=1
CLASSIFICATION_CACHE_SIZE=512
MAX_REQUEST_BODY_BYTES=1000000

# Rate limit: адрес сокета по умолчанию; X-Forwarded-For только за TRUSTED_PROXIES.
# Для нагрузочных прогонов: RATE_LIMIT_ENABLED=false.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=20
RATE_LIMIT_ADMIN_RPS=1
RATE_LIMIT_ADMIN_BURST=2
# Отдельный лимит на POST /classify/file — в файлах (один файл = до 100 позиций).
RATE_LIMIT_FILE_RPS=1
RATE_LIMIT_FILE_BURST=3
# Адреса/CIDR обратных прокси, которым доверяем X-Forwarded-For. Пусто — заголовок
# игнорируется, клиент определяется по сокету (подделка заголовка не помогает).
# За прокси укажите его адрес, иначе все клиенты попадут в один бакет:
#   TRUSTED_PROXIES=10.0.0.1,172.17.0.1
TRUSTED_PROXIES=
ADMIN_API_KEY=

# Фоновые задачи: sqlite (переживают рестарт) | memory (для тестов).
# JOB_STORE_PATH внутри контейнера указывает на volume jobs_data.
JOB_STORE=sqlite
JOB_TTL_HOURS=24

QDRANT_PORT=6333
QDRANT_BIND_ADDRESS=127.0.0.1
QDRANT_COLLECTION=pp1875_items
QDRANT_MEMORY_LIMIT=768m
QDRANT_CPUS=1.0
API_MEMORY_LIMIT=1g
API_CPUS=2.0

# Embedder backend: auto | sentence-transformers | tfidf (офлайн-фолбэк)
EMBEDDER_BACKEND=auto
TFIDF_DIM=512
MODELS_DIR=./models

# Пороги catalog backend: пусто = оставить значения из артефакта модели.
# Диапазон каждого значения 0..1; должно выполняться OK_FLOOR > REVIEW_FLOOR.
# Изменение применяется при следующем старте API/worker, пересобирать модель не нужно.
CATALOG_OK_FLOOR=
CATALOG_REVIEW_FLOOR=

# Пороги решения для семантического режима (CLASSIFIER_BACKEND=qdrant).
# Артефакт модели хранит точку, снятую на лексике (ok 0.77 / review 0.165),
# но шкала сырой уверенности у семантики сжата: review 0.25 поднимает точность
# честного `not_found` с 89.8% до 97.2% (eval/experiments.md, эксп. 16).
# `ok` на измеряемые метрики не влияет — он лишь помечает ответ уверенным.
# Пустое значение = оставить порог из артефакта.
QDRANT_OK_FLOOR=0.77
QDRANT_REVIEW_FLOOR=0.25

# Реранкер семантического режима: auto — артефакт под активный эмбеддер
# (reranker.<tag>.json), иначе лексический reranker.json; lexical — всегда
# лексический (откат без пересборки образа). С vector-features артефактом
# сырая шкала меняется: перемерьте пороги (eval/threshold_sweep.py --backend qdrant).
SEMANTIC_RERANKER=auto

# CORS для отдельно размещённого фронтенда ("*" или список origin через запятую)
CORS_ALLOW_ORIGINS=*
