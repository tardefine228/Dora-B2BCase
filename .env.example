# Copy to .env for local Docker Compose configuration. Do not commit .env.
API_PORT=8000
API_BIND_ADDRESS=0.0.0.0
LOG_LEVEL=INFO
# Формат логов: json (один JSON-объект на строку, для агрегаторов; в docker compose
# включается по умолчанию) или text (человекочитаемый, для локального запуска).
LOG_FORMAT=json
CLASSIFIER_BACKEND=catalog

# Тяжёлый шаг сборки образа: torch (CPU) + sentence-transformers + веса модели
# с Hugging Face + обучение реранкера (~10 минут в первый раз). По умолчанию
# включён; быстрая сборка (~2 мин) без него — рантайм останется на spaCy-векторах:
#   INSTALL_TRANSFORMER=false docker compose up --build
INSTALL_TRANSFORMER=true

# ML/Qdrant is optional and requires a local model directory before going offline.
# To enable the semantic backend: INSTALL_ML=true, CLASSIFIER_BACKEND=qdrant,
# then download the transformer (see scripts/download_model.py) and set a strong
# ADMIN_API_KEY. Compose also sets the runtime ML_ENABLED flag from INSTALL_ML.
INSTALL_ML=false
# Do NOT set MODEL_NAME in .env for the docker compose stack: the image bakes the
# transformer into /opt/models/embedder and compose already defaults MODEL_NAME to
# that path. A stale host path here (e.g. ./models/bge-m3 from older revisions)
# silently downgrades the runtime to spaCy vectors - /health/ready then reports
# "spacy-ru_core_news_md" even though the build downloaded e5 successfully.
# Uncomment only to point the stack at a custom model directory:
#MODEL_NAME=/opt/models/embedder
MODEL_DEVICE=cpu
MODEL_LOCAL_ONLY=true
MODEL_BATCH_SIZE=16
# Обрезка входа по токенам (0 = оставить значение модели). Названия товаров короткие
# (медиана 63 символа, самое длинное — 1164), а у моделей с длинным контекстом
# (BAAI/bge-m3 — 8192) буферы под контекст съедают память впустую. 512 токенов
# покрывают весь каталог.
MODEL_MAX_SEQ_LENGTH=512

# Другая модель эмбеддингов (например BAAI/bge-m3, 1024 измерения): задайте при сборке
#   EMBEDDER_MODEL=BAAI/bge-m3 docker compose build
# и поднимите память: BGE-M3 — 568M параметров (~2.3 ГБ весов), api/worker нужны 4 ГБ,
# MODEL_BATCH_SIZE=4..8. Тег эмбеддера входит в имена кэша векторов и артефакта
# реранкера, поэтому старые артефакты не переиспользуются; реранкер нужно пересобрать
# (scripts/build_model.py --dense), иначе векторные признаки останутся с весом 0.
# Семафор фоновых инференсов на процесс. Замеры BE-7 (eval/api-load-test.md,
# 2026-10-21): на CPU-bound классификации MCI=2/4 не дают прироста стенки, но
# опрос статуса деградирует в 1.9x/4.1x по p95, а RSS растёт. Масштабирование —
# процессами (workers/реплики/Celery), не этим значением.
MAX_CONCURRENT_INFERENCES=1
CLASSIFICATION_CACHE_SIZE=512
MAX_REQUEST_BODY_BYTES=1000000

# Rate limit: адрес сокета по умолчанию; X-Forwarded-For только за TRUSTED_PROXIES.
# Для нагрузочных прогонов: RATE_LIMIT_ENABLED=false.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=20
RATE_LIMIT_ADMIN_RPS=1
RATE_LIMIT_ADMIN_BURST=2
# Отдельный лимит на POST /classify/file — в файлах (один файл = до 100 позиций).
RATE_LIMIT_FILE_RPS=1
RATE_LIMIT_FILE_BURST=3
# Адреса/CIDR обратных прокси, которым доверяем X-Forwarded-For. Пусто — заголовок
# игнорируется, клиент определяется по сокету (подделка заголовка не помогает).
# За прокси укажите его адрес, иначе все клиенты попадут в один бакет:
#   TRUSTED_PROXIES=10.0.0.1,172.17.0.1
TRUSTED_PROXIES=
ADMIN_API_KEY=

# Для локального запуска вне Docker: sqlite | memory.
# В docker-compose.yml принудительно используются PostgreSQL + Celery.
# JOB_STORE_PATH внутри контейнера указывает на volume jobs_data.
JOB_STORE=sqlite
JOB_TTL_HOURS=24

# Срок хранения журналов (только PostgreSQL). 0 = хранить вечно.
# AUDIT_RETENTION_DAYS — журнал запросов (копии описаний закупок, чистится);
# FEEDBACK_RETENTION_DAYS — вердикты специалистов (обучающие данные, по умолчанию вечно);
# MAINTENANCE_INTERVAL_HOURS — как часто планировщик применяет срок хранения.
AUDIT_RETENTION_DAYS=90
FEEDBACK_RETENTION_DAYS=0
MAINTENANCE_INTERVAL_HOURS=24

# Сколько снимков каталога хранить перед загрузками (откат: POST /admin/catalog/rollback).
CATALOG_SNAPSHOT_KEEP=10

QDRANT_PORT=6333
QDRANT_BIND_ADDRESS=127.0.0.1
QDRANT_COLLECTION=pp1875_items
QDRANT_MEMORY_LIMIT=768m
QDRANT_CPUS=1.0
# Postgres/Redis лимиты по умолчанию совпадают с docker-compose.yml; меняйте
# синхронно с API_MEMORY_LIMIT/WORKER_MEMORY_LIMIT при профилировании памяти.
POSTGRES_MEMORY_LIMIT=256m
REDIS_MEMORY_LIMIT=128m
# Пароль БД: в проде замените дефолт. Та же переменная подставляется compose
# в DATABASE_URL, поэтому менять нужно только её одну.
POSTGRES_PASSWORD=dora

# --- Опциональный стек наблюдения: `docker compose --profile monitoring up` ----
# Prometheus: http://127.0.0.1:9090, Grafana: http://127.0.0.1:3000 (admin / пароль).
# Порты слушают только loopback; наружу публикуйте через обратный прокси с TLS.
PROMETHEUS_PORT=9090
PROMETHEUS_MEMORY_LIMIT=512m
PROMETHEUS_RETENTION=15d
GRAFANA_PORT=3000
GRAFANA_MEMORY_LIMIT=256m
GRAFANA_ADMIN_PASSWORD=dora
# api/worker грузят свою копию модели: e5-small (118M) хватает 2 ГБ, BGE-M3 (568M)
# требует 4 ГБ на контейнер, иначе контейнер будет убит по OOM во время инференса.
API_MEMORY_LIMIT=2g
API_CPUS=2.0
WORKER_MEMORY_LIMIT=2g
WORKER_CPUS=2.0

# Embedder backend: auto | sentence-transformers | tfidf (офлайн-фолбэк)
EMBEDDER_BACKEND=auto
TFIDF_DIM=512
MODELS_DIR=./models

# Пороги catalog backend: пусто = оставить значения из артефакта модели.
# Диапазон каждого значения 0..1; должно выполняться OK_FLOOR > REVIEW_FLOOR.
# Изменение применяется при следующем старте API/worker, пересобирать модель не нужно.
CATALOG_OK_FLOOR=
CATALOG_REVIEW_FLOOR=

# Пороги решения для семантического режима (CLASSIFIER_BACKEND=qdrant).
# Пороги семантического режима. Лексический артефакт хранит ok 0.77 / review 0.227,
# но шкала сырой уверенности у семантики сжата: review 0.25 поднимает точность
# честного `not_found` с 89.8% до 97.2% (eval/experiments.md, эксп. 16; на артефакте
# того времени — с 85.2% до 97.2%).
# `ok` на измеряемые метрики не влияет — он лишь помечает ответ уверенным.
# Пустое значение = оставить порог из артефакта.
QDRANT_OK_FLOOR=0.77
QDRANT_REVIEW_FLOOR=0.45

# Какой артефакт скорит при включённых векторах (каталоговый и семантический режимы):
# auto — артефакт под активный эмбеддер (reranker.<tag>.json), иначе лексический
# reranker.json; lexical — всегда лексический (откат без пересборки образа, векторы
# остаются кандидатами). С vector-features артефактом шкала меняется: перемерьте
# пороги (eval/run_eval.py --sweep, eval/pareto.py).
SEMANTIC_RERANKER=auto

# CORS для отдельно размещённого фронтенда ("*" или список origin через запятую)
CORS_ALLOW_ORIGINS=*

# --- Третья ступень: LLM-верификация остаточного review/not_found ---------------
# Выключена по умолчанию. Когда включена, модель языка получает название товара и
# НЕ БОЛЕЕ ТРЁХ позиций перечня с кодами и может выбрать только одну из них или
# ответить «none». Придуманные коды, таймауты и ошибки сети игнорируются: ответ
# остаётся таким, каким его дал классификатор. Подтверждённый код показывается
# как review (кандидат для человека), никогда как ok.
# Работает с любым OpenAI-совместимым endpoint (OpenAI, OpenRouter, vLLM, Ollama):
#   LLM_VERIFIER_ENABLED=true
#   LLM_VERIFIER_BASE_URL=https://api.openai.com/v1
#   LLM_VERIFIER_API_KEY=...
#   LLM_VERIFIER_MODEL=gpt-4o-mini
# Стоимость: одна короткая беседа на строку только для слабых ответов (~50 из 100
# строк выгрузки) + кэш по паре «запрос + тройка кодов». Потолок
# LLM_VERIFIER_CALLS_PER_MINUTE защищает от случайного счёта на большом файле.
LLM_VERIFIER_ENABLED=false
LLM_VERIFIER_BASE_URL=https://api.openai.com/v1
LLM_VERIFIER_API_KEY=
LLM_VERIFIER_MODEL=
LLM_VERIFIER_TIMEOUT=8
LLM_VERIFIER_CALLS_PER_MINUTE=60

# Одна переменная управляет двумя рубежами защиты от тихой деградации:
#   1) сборка образа: при false сбой загрузки/обучения модели роняет build
#      (см. api/Dockerfile, ARG ALLOW_DEGRADE);
#   2) рантайм: при false отсутствие калиброванного артефакта реранкера при старте
#      переводит /health/ready в 503 вместо тихой замены на эвристический скоринг
#      (пороги которого не откалиброваны). true — только для диагностики.
ALLOW_DEGRADE=false
