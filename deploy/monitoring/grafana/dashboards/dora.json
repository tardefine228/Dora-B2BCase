  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "dora-prometheus"
        },
        "hide": 0,
        "label": "Datasource",
        "refresh": 1
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "Dora B2B — сервис и классификация",
  "uid": "dora-b2b-overview",
  "version": 1,
  "weekStart": "",
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "HTTP-трафик",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Запросов в секунду по коду ответа",
      "datasource": { "type": "prometheus", "uid": "dora-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(dora_http_requests_total[1m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Латентность: p50 / p95 / p99, с",
      "datasource": { "type": "prometheus", "uid": "dora-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(dora_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(dora_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(dora_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Доля 5xx за 5 минут",
      "datasource": { "type": "prometheus", "uid": "dora-prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 9 },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "thresholds": {
          "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 0.01 },
            { "color": "red", "value": 0.05 }
          ]
        } },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(dora_http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(dora_http_requests_total[5m])), 0.0001)"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Отклонено rate limiter (429)",
      "datasource": { "type": "prometheus", "uid": "dora-prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 9 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (path) (rate(dora_http_rate_limited_total[5m]))",
          "legendFormat": "{{path}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Всего запросов (на момент снятия)",
      "datasource": { "type": "prometheus", "uid": "dora-prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 9 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [
        { "refId": "A", "expr": "sum(dora_http_requests_total)" }
      ]
    },
    {
      "id": 10,
      "type": "row",
      "title": "ML-контур",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 }
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Готовность компонентов (1 = работает)",
      "datasource": { "type": "prometheus", "uid": "dora-prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "down", "color": "red" }, "1": { "text": "up", "color": "green" } } }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background"
      },
      "targets": [
        { "refId": "A", "expr": "dora_classifier_up", "legendFormat": "classifier" },
        { "refId": "B", "expr": "dora_embedder_up", "legendFormat": "embedder" },
        { "refId": "C", "expr": "dora_vector_store_up", "legendFormat": "vector store" }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Ответы классификатора по статусу",
      "datasource": { "type": "prometheus", "uid": "dora-prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(dora_classifications_total[5m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "События пакетных задач за час",
      "datasource": { "type": "prometheus", "uid": "dora-prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (event) (increase(dora_batch_jobs_total[1h]))",
          "legendFormat": "{{event}}"
        }
      ]
    },
    {
      "id": 14,
      "type": "stat",
      "title": "Активный эмбеддер / размер векторного индекса",
      "datasource": { "type": "prometheus", "uid": "dora-prometheus" },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 22 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull", "last"], "fields": "", "values": false }
      },
      "targets": [
        { "refId": "A", "expr": "dora_vector_positions", "legendFormat": "позиций в индексе" },
        { "refId": "B", "expr": "dora_embedder_dim", "legendFormat": "размерность эмбеддинга" },
        { "refId": "C", "expr": "dora_embedder_info", "legendFormat": "{{tag}}" }
      ]
    }
  ]
}
